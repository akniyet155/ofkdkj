{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/logos/(.*)", "dest": "/logos/$1", "headers": { "cache-control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/index.html", "headers": { "cache-control": "public, max-age=3600" } }
  ]
}
